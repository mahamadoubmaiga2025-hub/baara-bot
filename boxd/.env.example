# Baara — configuration (à copier en .env : cp .env.example .env)
# BOT_TOKEN : le token donné par @BotFather pour le nouveau bot (jamais dans le chat ni dans Git).
BOT_TOKEN=
BOT_USERNAME=Baaramlbot
ADMIN_ID=883782997
PORT=8000
# Optionnel : jeton du relais d'offres (MaliPages). Laisser vide au lancement ;
# il sera aligné avec le relais de Muse au premier branchement.
RADAR_PUSH_TOKEN=

# --- Intelligence (optionnel mais recommandé) ---
# Sans clé : Baara fonctionne en mode déterministe (règles + gabarits).
# Avec clé : texte libre compris, lettre et CV adapté rédigés par IA, simulation
# d'entretien avec retours, lecture des CV PDF / photos d'annonces / vocaux.
# Vycea (primaire) : la clé de ton compte Vycea. Gemini (repli + médias) : clé Google AI Studio.
VYCE_API_KEY=
GEMINI_API_KEY=

# Numéros marchand affichés pour les paiements Premium
OM_NUMBER=+22372072072
WAVE_NUMBER=+22372072072
